udiskie
gvfs-mtp
gvfs-nfs
gvfs-smb
dosfstools
exfatprogs
btrfs-progs
bolt
kernel-modules-hook
gnome-disk-utility

# Printing
cups
cups-filters
cups-pk-helper
system-config-printer

# Security
ufw
gnome-keyring
libsecret

# Boot and snapshots
limine
snapper
zram-generator

# System utilities
plocate
man-db
expac
pacman-contrib

# Terminals
foot
kitty

# Fonts and icons
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
fontconfig
woff2-font-awesome
gnome-themes-extra

