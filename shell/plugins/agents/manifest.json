{
  "schemaVersion": 1,
  "id": "blob.agents",
  "name": "Agents",
  "version": "1.0.0",
  "author": "Blob",
  "description": "Claude Code usage limits and token stats",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Agents",
    "description": "Claude Code session and weekly limits, with token stats from local transcripts",
    "category": "AI",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 900
    },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 30, "max": 3600, "step": 30, "defaultValue": 900 }
    ]
  }
}
